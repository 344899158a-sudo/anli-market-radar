{
  "version": "3.1.0",
  "name": "ANLI validation and portfolio risk loop",
  "base_contract_version": "3.0.0",
  "canonical_sources": {
    "market_and_playbook_risk": "config/rules/v2.json",
    "account_protection": "config/rules/v1.yaml"
  },
  "validation": {
    "tracked_states": [
      "RESEARCH_READY",
      "WAIT_TRIGGER",
      "EVIDENCE_GAP",
      "BLOCKED",
      "NO_SETUP",
      "DATA_GAP"
    ],
    "shadow_entry_states": [
      "RESEARCH_READY"
    ],
    "outcome_horizons_sessions": [1, 3, 5, 10, 20],
    "minimum_sample_count": 30,
    "primary_horizon_sessions": 5,
    "append_only": true,
    "note": "影子记录只用于验证规则输出，不代表真实成交，不包含滑点、手续费或保证收益。"
  },
  "portfolio": {
    "require_account_equity": true,
    "require_position_quantity": true,
    "require_average_cost": true,
    "require_stop_price": true,
    "caution_utilization_fraction": "0.80",
    "fail_closed_on_missing_position": true
  },
  "model_labels": {
    "market_score": {
      "label": "趋势环境强度",
      "warning": "衡量指数趋势、宽度、波动率与宏观条件，不等于适合交易概率。"
    },
    "technical_confidence": {
      "label": "多周期结构一致度",
      "warning": "这是规则一致性分，不是统计置信概率。"
    },
    "evidence_completion": {
      "label": "规则证据完成度",
      "warning": "表示证据链完整程度，不是胜率。"
    }
  },
  "compatibility": {
    "v1_route": "/v1.html",
    "v2_route": "/playbooks.html",
    "v3_route": "/v3.html",
    "v31_route": "/",
    "trendiq_route": "/qqq_trendiq.html"
  },
  "automatic_ordering": false,
  "research_only": true
}
